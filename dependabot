version: 2
updates:
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    # Assign specific team members or individuals to reviews
    assignees:
      - "octocat"
    # Attach labels to help prioritize the PRs
    labels:
      - "dependencies"
      - "javascript"
    # Restrict the total amount of open PRs generated by this ecosystem
    open-pull-requests-limit: 10
    # Ignore specific versions or packages completely
    ignore:
      - dependency-name: "lodash"
        versions: ["^4.0.0"]
